@model RadiCore.ViewModel.SettingsViewModel
@{
    ViewData["Title"] = "設定";
}

<h2 class="mb-4">設定</h2>

<div class="row g-4">
    @* スケジューラ一時停止カード *@
    <div class="col-12">
        <div class="card" id="schedulerCard">
            <div class="card-header fw-bold" id="schedulerCardHeader">スケジューラ</div>
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span id="schedulerBadge" class="badge"></span>
                            <span class="fw-bold">録音・番組表更新の一時停止</span>
                        </div>
                        <div class="text-muted small">
                            一時停止中は、予約録音・番組表の自動更新・手動実行のいずれも実行されません（予約の登録・編集・削除は通常どおり行えます）。<br />
                            一時停止中に予定時刻を過ぎた繰り返し録音と番組表更新は、再開時にまとめて実行されず、次回の予定時刻を待ちます。<br />
                            この設定はアプリを再起動しても維持されます。
                        </div>
                    </div>
                    <div class="form-check form-switch fs-3 mb-0 me-2">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="schedulerPaused" checked="@Model.SchedulerPaused" />
                        <label class="form-check-label fs-6" for="schedulerPaused">一時停止する</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* 手動実行カード *@
    <div class="col-12 col-md-6">
        <div class="card h-100" id="runNowCard">
            <div class="card-header fw-bold" id="runNowCardHeader">番組表の手動更新</div>
            <div class="card-body d-flex flex-column justify-content-between">
                <p class="small mb-3" id="runNowCardDesc">
                    今すぐ番組表を取得・更新します。通常は定期実行されますが、すぐに最新の番組情報が必要な場合にご利用ください。
                </p>
                @* 直近実行サマリー *@
                <div id="lastRunSummary" class="mb-3 p-2 rounded border small d-none">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span id="summaryBadge" class="badge"></span>
                        <span class="text-muted">開始: <span id="summaryStartedAt"></span></span>
                        <span class="text-muted">終了: <span id="summaryFinishedAt"></span></span>
                        <span class="text-muted">所要: <span id="summaryElapsed"></span></span>
                    </div>
                </div>
                <div id="lastRunNone" class="mb-3 text-muted small d-none">実行履歴なし</div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary w-50" id="btnRunNow">今すぐ実行</button>
                    <button type="button" class="btn btn-outline-secondary w-50" id="btnShowLog">ログを見る</button>
                </div>
            </div>
        </div>
    </div>

    @* スケジュール・並列数設定カード *@
    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-header fw-bold">定期実行の設定</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">番組表更新時刻</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="number" class="form-control text-center"
                               id="refreshHour" value="@Model.RefreshHour"
                               min="@Model.MinRefreshHour" max="@Model.MaxRefreshHour" style="width:80px" />
                        <span>時</span>
                        <input type="number" class="form-control text-center"
                               id="refreshMinute" value="@Model.RefreshMinute"
                               min="@Model.MinRefreshMinute" max="@Model.MaxRefreshMinute" style="width:80px" />
                        <span>分</span>
                    </div>
                    <div class="form-text">毎日この時刻に番組表を自動更新します（デフォルト: @Model.DefaultRefreshHour:@Model.DefaultRefreshMinute.ToString("D2")）</div>
                </div>
                <div class="mb-4">
                    <label class="form-label">番組表取得の並列数</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="number" class="form-control text-center"
                               id="parallelCount" value="@Model.ParallelCount"
                               min="@Model.MinParallelCount" max="@Model.MaxParallelCount" style="width:80px" />
                        <span>並列</span>
                    </div>
                    <div class="form-text">放送局ごとの番組取得を何並列で行うか設定します（デフォルト: @Model.DefaultParallelCount）</div>
                </div>
                <button type="button" class="btn btn-success w-100" id="btnSave">保存</button>
            </div>
        </div>
    </div>

    @* 録音ファイル名設定カード *@
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-bold">録音ファイル名</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="fileNameTemplate">ファイル名テンプレート</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="fileNameTemplate"
                               value="@Model.FileNameTemplate" maxlength="@Model.MaxFileNameTemplateLength"
                               spellcheck="false" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" id="btnResetFileNameTemplate">既定に戻す</button>
                    </div>
                    <div class="form-text">
                        番組のメタデータをプレースホルダーで埋め込めます（デフォルト: <code>@Model.DefaultFileNameTemplate</code>）。
                        拡張子 <code>.m4a</code> は自動で付きます。ファイル名に使えない文字は <code>_</code> に置き換えられます。
                    </div>
                    <div class="mt-2 small">
                        プレビュー: <code id="fileNamePreview">—</code>
                        <span id="fileNamePreviewError" class="text-danger ms-2"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-label">使用できるプレースホルダー<span class="text-muted small">（クリックで挿入）</span></div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var ph in Model.FileNamePlaceholders)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary placeholder-insert"
                                    data-token="@ph.Token"
                                    title="@ph.Description@(ph.SupportsFormat ? "（{名前:書式} で書式指定可）" : "")">
                                <code class="text-reset">@ph.Token</code>
                                <span class="text-muted ms-1">@ph.Description</span>
                            </button>
                        }
                    </div>
                    <div class="form-text">
                        日付・時刻は <code>{date:yyyy-MM-dd}</code> のように .NET の日時書式で指定できます。
                    </div>
                </div>

                <button type="button" class="btn btn-success w-100" id="btnSaveFileName">保存</button>
            </div>
        </div>
    </div>
</div>

<!-- 実行ログ モーダル -->
<div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="logModalLabel">番組表更新 直近実行ログ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
            </div>
            <div class="modal-body">
                <!-- サマリー -->
                <div id="logSummary" class="mb-3 d-none">
                    <div class="d-flex gap-3 align-items-center flex-wrap">
                        <span id="logBadge" class="badge fs-6"></span>
                        <small class="text-muted">開始: <span id="logStartedAt"></span></small>
                        <small class="text-muted">終了: <span id="logFinishedAt"></span></small>
                        <small class="text-muted">所要: <span id="logElapsed"></span></small>
                    </div>
                </div>
                <!-- ログ本文 -->
                <pre id="logContent"
                     class="bg-dark text-light rounded p-3 small"
                     style="max-height:460px; overflow-y:auto; white-space:pre-wrap; word-break:break-all;">
                </pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="appToast" class="toast text-bg-success border-0">
        <div class="toast-body"></div>
    </div>
</div>

@section Scripts {
<script>
    function showToast(message, type) {
        const toastEl = document.getElementById('appToast');
        toastEl.classList.remove('text-bg-success', 'text-bg-danger');
        toastEl.classList.add(`text-bg-${type}`);
        toastEl.querySelector('.toast-body').textContent = message;
        new bootstrap.Toast(toastEl, { delay: 2000 }).show();
    }

    // サマリーをカードに反映する共通関数
    function applyLogSummary(res) {
        const summaryEl = document.getElementById('lastRunSummary');
        const noneEl    = document.getElementById('lastRunNone');
        if (!res.exists) {
            summaryEl.classList.add('d-none');
            noneEl.classList.remove('d-none');
            return;
        }
        const badge = document.getElementById('summaryBadge');
        if (res.isRunning) {
            badge.textContent = '実行中...';
            badge.className   = 'badge bg-warning text-dark';
        } else {
            badge.textContent = res.succeeded ? '成功' : '失敗';
            badge.className   = 'badge ' + (res.succeeded ? 'bg-success' : 'bg-danger');
        }
        document.getElementById('summaryStartedAt').textContent  = res.startedAt;
        document.getElementById('summaryFinishedAt').textContent = res.isRunning ? '—' : res.finishedAt;
        document.getElementById('summaryElapsed').textContent    = res.isRunning ? '—' : res.elapsed;
        noneEl.classList.add('d-none');
        summaryEl.classList.remove('d-none');
    }

    // ページロード時にサマリー取得（実行中ならそのままポーリング開始）
    fetch('/Settings/GetLastRefreshLog')
        .then(res => res.json())
        .then(function (res) {
            applyLogSummary(res);
            if (res.exists && res.isRunning) startPolling();
        });

    // ポーリング設定
    const POLL_INTERVAL_MS = 3000;
    const POLL_TIMEOUT_MS  = 5 * 60 * 1000; // 5分
    let pollTimer    = null;
    let pollDeadline = null;

    function setCardRunning(running) {
        const card       = document.getElementById('runNowCard');
        const header     = document.getElementById('runNowCardHeader');
        const desc       = document.getElementById('runNowCardDesc');
        if (running) {
            card.classList.add('border-warning');
            header.classList.add('bg-warning', 'bg-opacity-25');
            desc.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>番組表を更新しています。しばらくお待ちください...';
            desc.classList.remove('text-muted');
        } else {
            card.classList.remove('border-warning');
            header.classList.remove('bg-warning', 'bg-opacity-25');
            desc.textContent = '今すぐ番組表を取得・更新します。通常は定期実行されますが、すぐに最新の番組情報が必要な場合にご利用ください。';
            desc.classList.add('text-muted');
        }
    }

    function startPolling() {
        if (pollTimer) return; // 二重起動防止
        setCardRunning(true);
        pollDeadline = Date.now() + POLL_TIMEOUT_MS;
        pollTimer = setInterval(function () {
            if (Date.now() > pollDeadline) {
                stopPolling();
                showToast('実行完了を確認できませんでした（タイムアウト）。', 'danger');
                return;
            }
            fetch('/Settings/GetLastRefreshLog')
                .then(res => res.json())
                .then(function (res) {
                    if (!res.exists || res.isRunning) return; // まだ実行中
                    stopPolling();
                    applyLogSummary(res);
                    showToast(res.succeeded ? '番組表更新が完了しました。' : '番組表更新が失敗しました。', res.succeeded ? 'success' : 'danger');
                });
        }, POLL_INTERVAL_MS);
    }

    function stopPolling() {
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
        setCardRunning(false);
    }

    // 今すぐ実行
    document.getElementById('btnRunNow').addEventListener('click', function () {
        const btn = this;
        btn.disabled = true;
        btn.textContent = '実行中...';

        fetch('/Settings/RunNow', { method: 'POST' })
            .then(function (res) { if (!res.ok) throw new Error(); return res.json(); })
            .then(function (res) {
                showToast(res.message, res.success ? 'success' : 'danger');
                if (res.success) startPolling();
            })
            .catch(function () {
                showToast('エラーが発生しました。', 'danger');
            });

        // ポーリング完了 or タイムアウト後にボタンを戻す
        const restoreBtn = setInterval(function () {
            if (!pollTimer) {
                btn.textContent = '今すぐ実行';
                applySchedulerState(document.getElementById('schedulerPaused').checked);
                clearInterval(restoreBtn);
            }
        }, 500);
    });

    // 一時停止の切り替え
    const pausedSwitch = document.getElementById('schedulerPaused');

    function applySchedulerState(paused) {
        const badge  = document.getElementById('schedulerBadge');
        const card   = document.getElementById('schedulerCard');
        const header = document.getElementById('schedulerCardHeader');
        const runNow = document.getElementById('btnRunNow');

        badge.textContent = paused ? '一時停止中' : '稼働中';
        badge.className   = 'badge ' + (paused ? 'bg-danger' : 'bg-success');
        card.classList.toggle('border-danger', paused);
        header.classList.toggle('bg-danger', paused);
        header.classList.toggle('bg-opacity-25', paused);

        // 一時停止中はトリガーが発火しないため手動実行もできない
        runNow.disabled = paused;
        runNow.title    = paused ? '一時停止中は実行できません' : '';
    }

    applySchedulerState(pausedSwitch.checked);

    pausedSwitch.addEventListener('change', async function () {
        const paused = pausedSwitch.checked;
        pausedSwitch.disabled = true;

        try {
            const res = await fetch('/Settings/SetSchedulerPaused', {
                method: 'POST',
                body: new URLSearchParams({ paused: paused })
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            applySchedulerState(data.paused);
            showToast(data.message, data.paused ? 'danger' : 'success');
        } catch {
            pausedSwitch.checked = !paused; // 失敗時は元に戻す
            showToast('エラーが発生しました。', 'danger');
        } finally {
            pausedSwitch.disabled = false;
        }
    });

    // 設定保存（どちらの保存ボタンからも画面上の全設定を送信する）
    async function saveSettings(btn) {
        btn.disabled = true;
        btn.textContent = '保存中...';

        try {
            const res = await fetch('/Settings/Save', {
                method: 'POST',
                body: new URLSearchParams({
                    refreshHour: document.getElementById('refreshHour').value,
                    refreshMinute: document.getElementById('refreshMinute').value,
                    parallelCount: document.getElementById('parallelCount').value,
                    fileNameTemplate: document.getElementById('fileNameTemplate').value
                })
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            showToast(data.message, data.success ? 'success' : 'danger');
        } catch {
            showToast('エラーが発生しました。', 'danger');
        } finally {
            btn.disabled = false;
            btn.textContent = '保存';
        }
    }

    document.getElementById('btnSave').addEventListener('click', function () { saveSettings(this); });
    document.getElementById('btnSaveFileName').addEventListener('click', function () { saveSettings(this); });

    // ファイル名テンプレートのプレビュー（入力の都度サーバーで展開する）
    const templateInput  = document.getElementById('fileNameTemplate');
    const previewEl      = document.getElementById('fileNamePreview');
    const previewErrorEl = document.getElementById('fileNamePreviewError');
    let previewTimer = null;

    function updateFileNamePreview() {
        fetch('/Settings/PreviewFileName?' + new URLSearchParams({ fileNameTemplate: templateInput.value }))
            .then(function (res) { if (!res.ok) throw new Error(); return res.json(); })
            .then(function (res) {
                previewEl.textContent = res.fileName;
                previewEl.classList.toggle('text-danger', !res.valid);
                previewErrorEl.textContent = res.message;
            })
            .catch(function () {
                previewEl.textContent = '—';
                previewErrorEl.textContent = 'プレビューの取得に失敗しました。';
            });
    }

    templateInput.addEventListener('input', function () {
        clearTimeout(previewTimer);
        previewTimer = setTimeout(updateFileNamePreview, 300);
    });
    updateFileNamePreview();

    // プレースホルダーをカーソル位置へ挿入
    document.querySelectorAll('.placeholder-insert').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const token = btn.dataset.token;
            const start = templateInput.selectionStart ?? templateInput.value.length;
            const end   = templateInput.selectionEnd   ?? templateInput.value.length;
            templateInput.value = templateInput.value.slice(0, start) + token + templateInput.value.slice(end);
            templateInput.focus();
            templateInput.selectionStart = templateInput.selectionEnd = start + token.length;
            updateFileNamePreview();
        });
    });

    // 既定のテンプレートに戻す
    document.getElementById('btnResetFileNameTemplate').addEventListener('click', function () {
        templateInput.value = '@Model.DefaultFileNameTemplate';
        updateFileNamePreview();
    });

    // ログ表示
    document.getElementById('btnShowLog').addEventListener('click', function () {
        const logContent = document.getElementById('logContent');
        const logSummary = document.getElementById('logSummary');
        logContent.textContent = '読み込み中...';
        logSummary.classList.add('d-none');

        fetch('/Settings/GetLastRefreshLog')
            .then(function (res) { if (!res.ok) throw new Error(); return res.json(); })
            .then(function (res) {
                if (!res.exists) {
                    logContent.textContent = '実行履歴がありません。';
                } else {
                    const badge = document.getElementById('logBadge');
                    badge.textContent  = res.succeeded ? '成功' : '失敗';
                    badge.className    = 'badge fs-6 ' + (res.succeeded ? 'bg-success' : 'bg-danger');
                    document.getElementById('logStartedAt').textContent  = res.startedAt;
                    document.getElementById('logFinishedAt').textContent = res.finishedAt;
                    document.getElementById('logElapsed').textContent    = res.elapsed;
                    logSummary.classList.remove('d-none');
                    logContent.textContent = res.lines.join('\n');
                    logContent.scrollTop = logContent.scrollHeight;
                }
            })
            .catch(function () {
                logContent.textContent = 'ログの取得に失敗しました。';
            });

        new bootstrap.Modal(document.getElementById('logModal')).show();
    });
</script>
}
