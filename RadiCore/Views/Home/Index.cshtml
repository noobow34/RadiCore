@using RadiCore.ViewModel
@model ProgramFilterViewModel

<div class="container-fluid">
    <h3 class="mb-3">🗓️ 番組表</h3>

    <!-- フィルタ -->
    <div class="row g-2 mb-3">
        <!-- 地区 -->
        <div class="col-4 col-md-3">
            <select id="region" class="form-select">
                <option value="">地区</option>
                @foreach (var s in Model.Regions)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>

        <!-- 局 -->
        <div class="col-4 col-md-3">
            <select id="station" class="form-select" disabled>
                <option value="">放送局</option>
                @foreach (var s in Model.Stations)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>

        <!-- 日付 -->
        <div class="col-4 col-md-3">
            <input id="date"
                   type="date"
                   class="form-control"
                   min="@Model.MinDate"
                   max="@Model.MaxDate"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <!-- 番組表 -->
    <div id="program-table">
        <div class="text-center text-muted">
            条件を選択してください
        </div>
    </div>

</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="reserveToast" class="toast align-items-center text-bg-success border-0"
         role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                予約しました
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const regionSelect = document.getElementById('region');
        const stationSelect = document.getElementById('station');
        const dateInput = document.getElementById('date');
        const programTable = document.getElementById('program-table');

        regionSelect.addEventListener('change', async function () {
            const region = this.value;

            stationSelect.disabled = true;
            stationSelect.innerHTML = '<option value="">放送局</option>';
            programTable.innerHTML = '';

            if (!region) return;

            const res = await fetch('/Home/GetStations?' + new URLSearchParams({ region }));
            const stations = await res.json();
            for (const s of stations) {
                const option = document.createElement('option');
                option.value = s.id;
                option.textContent = s.name;
                stationSelect.append(option);
            }
            stationSelect.disabled = false;
        });

        async function loadProgramTable() {
            const stationId = stationSelect.value;
            const date = dateInput.value;

            if (!stationId || !date) return;

            const res = await fetch('/Home/ProgramTablePartial?' + new URLSearchParams({ stationId, date }));
            programTable.innerHTML = await res.text();
        }
        stationSelect.addEventListener('change', loadProgramTable);
        dateInput.addEventListener('change', loadProgramTable);

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.reserve-btn');
            if (!btn) return;

            // 初期状態
            document.querySelectorAll('.repeat-option').forEach(el => el.checked = false);
            document.getElementById('repeatOnce').checked = true;

            const timeRange = btn.dataset.time || '';
            const parts = timeRange.split('–').map(x => x.trim());

            document.getElementById('modalStartTime').value = parts[0] || '';
            document.getElementById('modalEndTime').value = parts[1] || '';
            document.getElementById('modalTitle').value = btn.dataset.title || '';
            document.getElementById('modalCast').value = btn.dataset.cast || '';
            document.getElementById('modalProgramId').value = btn.dataset.programId || '';

            bootstrap.Modal.getOrCreateInstance(document.getElementById('reserveModal')).show();
        });

        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('repeat-option')) return;

            document.querySelectorAll('.repeat-option').forEach(el => {
                if (el !== e.target) el.checked = false;
            });
            e.target.checked = true;

            const isRepeat = e.target.value !== 'once';
            document.getElementById('autoDeleteRow').classList.toggle('d-none', !isRepeat);
            if (!isRepeat) document.getElementById('autoDeleteCheckbox').checked = false;
        });

        document.addEventListener('click', async function (e) {
            if (!e.target.closest('#confirmReserve')) return;

            const repeatType = document.querySelector('.repeat-option:checked')?.value;

            const payload = {
                programId: document.getElementById('modalProgramId').value,
                title: document.getElementById('modalTitle').value,
                castName: document.getElementById('modalCast').value,
                startTime: document.getElementById('modalStartTime').value,
                endTime: document.getElementById('modalEndTime').value,
                repeatType: repeatType,
                isEdited: document.getElementById('isEditedCheckbox').checked,
                autoDeletePrevious: document.getElementById('autoDeleteCheckbox').checked
            };

            try {
                const res = await fetch('/Reservation/Create', { method: 'POST', body: new URLSearchParams(payload) });
                if (!res.ok) throw new Error();

                new bootstrap.Toast(document.getElementById('reserveToast'), { delay: 2000 }).show();
                bootstrap.Modal.getInstance(document.getElementById('reserveModal'))?.hide();
            } catch {
                alert('予約に失敗しました');
            }
        });
    </script>
}
