# docker compose 用の設定。このファイルを .env という名前で docker-compose.yml と同じフォルダに置き、値を設定してください。

# ── PostgreSQL ─────────────────────────────────────────────
# PostgreSQL は docker compose が専用コンテナとして自動で用意します。
# 以下はそのコンテナ内に初回起動時に作られるユーザー・パスワード・DB 名で、任意の値を決めて構いません。
# 既存の PostgreSQL を用意したり、その接続情報を記入したりする必要はありません。
# ※ パスワードは必ず変更してください。初回起動後に変更すると接続できなくなります。
POSTGRES_USER=radicore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radicore

# ── 公開ポート ─────────────────────────────────────────────
# RadiCore には認証機構がありません。既定ではホスト自身（127.0.0.1）からのみ接続できます。
# LAN 内に公開する場合でも、インターネットには直接公開せずリバースプロキシ等で保護してください。
RADICORE_BIND=127.0.0.1
RADICORE_PORT=8080

# ── radiko プレミアム（任意）───────────────────────────────
# 未設定ならフリー（エリア内）モードで動作します
RADIKO_MAIL=
RADIKO_PASS=

# ── ログアウトリンク（任意）────────────────────────────────
# RadiCore 自体には認証がありません。前段に認証プロキシを置いている場合のみ、
# そのログアウト URL を設定すると画面にログアウトリンクを表示します（未設定なら非表示）。
# 例: Cloudflare Access なら /cdn-cgi/access/logout
RADICORE_LOGOUT_URL=

# ── Slack 通知（任意）──────────────────────────────────────
# 両方設定した場合のみ、録音完了・エラー時に通知します
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=
