# docker compose 用の設定。このファイルを .env にコピーして値を設定してください。
#   cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────
# 初回起動時にこのユーザー・パスワード・DB 名でデータベースが作成されます
POSTGRES_USER=radicore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radicore

# ── 公開ポート ─────────────────────────────────────────────
# RadiCore には認証機構がありません。既定ではホスト自身（127.0.0.1）からのみ接続できます。
# LAN 内に公開する場合でも、インターネットには直接公開せずリバースプロキシ等で保護してください。
RADICORE_BIND=127.0.0.1
RADICORE_PORT=8080

# ── radiko プレミアム（任意）───────────────────────────────
# 未設定ならフリー（エリア内）モードで動作します
RADIKO_MAIL=
RADIKO_PASS=

# ── Slack 通知（任意）──────────────────────────────────────
# 両方設定した場合のみ、録音完了・エラー時に通知します
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=
